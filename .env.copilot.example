# Advice service only. Default provider retains Gemini.
COPILOT_AI_PROVIDER=gemini
COPILOT_OPENAI_API_KEY=

# Marketing draft generation only; does not borrow the Copilot or Studio key.
MARKETING_OPENAI_API_KEY=

# Enable only after staging acceptance on the persistent single-process server.
COPILOT_REALTIME_ENABLED=false
